{
  "permissions": {
    "allow": [
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(dotnet *)",
      "Bash(git *)",
      "PowerShell(flutter *)",
      "PowerShell(dart *)",
      "PowerShell(dotnet *)",
      "PowerShell(git *)",
      "PowerShell(./scripts/check.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout HEAD -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git checkout HEAD -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git stash drop*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dart-format.ps1"
            ],
            "timeout": 60,
            "statusMessage": "dart format"
          }
        ]
      }
    ]
  }
}
