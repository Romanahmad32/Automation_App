<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- TargetFramework, Nullable, ImplicitUsings und die Analyse-Einstellungen
         stehen in ../Directory.Build.props und gelten fuer alle Projekte. -->

    <PropertyGroup>
        <RootNamespace>AutomationService</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DocX" Version="5.2.0" />
        <PackageReference Include="FreeSpire.Doc" Version="14.4.0" />
        <PackageReference Include="MailKit" Version="4.17.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <!-- Explizit gepinnt, und zwar dauerhaft: Microsoft.AspNetCore.OpenApi
             fordert nur Microsoft.OpenApi ab 2.0.0 (offen nach oben), und von
             einem solchen Bereich nimmt NuGet die NIEDRIGSTE Fassung. Ohne
             diese Zeile landet also 2.0.0 im Paket, und darin steckt die
             Luecke GHSA-v5pm-xwqc-g5wc (hoch); gepatcht ist sie ab 2.7.5.

             Die Zeile darf nur innerhalb der 2er-Linie steigen. Version 3.x
             ist mit .NET 10 nicht baubar: dort ist IOpenApiMediaType.Example
             schreibgeschuetzt, waehrend der Source-Generator von
             Microsoft.AspNetCore.OpenApi weiterhin dorthin zuweist (CS0200 in
             OpenApiXmlCommentSupport.generated.cs). Der Fehler steht in
             generiertem Code, ist also nicht zu beheben. Deshalb ignoriert
             .github/dependabot.yml Major-Spruenge dieses Pakets. Beides
             aufheben, wenn das Projekt auf .NET 11 geht. -->
        <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
        <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.87.0" />
        <PackageReference Include="Microsoft.Office.Interop.Excel" Version="16.0.18925.20022" />
        <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
        <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
        <PackageReference Include="MimeKit" Version="4.17.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
        <!-- Explizit gepinnt, um die von Microsoft.Data.Sqlite transitiv gezogene
             SQLitePCLRaw 2.1.11 zu übersteuern (Sicherheitslücke GHSA-2m69-gcr7-jv3q
             in der gebündelten e_sqlite3-Native). Nicht entfernen, bis EF Core eine
             gepatchte Version transitiv mitbringt. Mit echter Migration verifiziert. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
      <!-- Das Test-Projekt liegt in einem Unterordner dieses Projekts. Ohne diese Ausschlüsse
           zieht das Web-SDK dessen bin/obj als Content mit und kopiert sie bei jedem Build
           tiefer verschachtelt (MSB3030). -->
      <Compile Remove="AutomationService.Tests\**\*.cs" />
      <Content Remove="AutomationService.Tests\**" />
      <None Remove="AutomationService.Tests\**" />
      <Folder Include="Core\" />
      <Folder Include="Generated\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="AGENTS.md" />
    </ItemGroup>

    <ItemGroup>
      <!--
        Die Word-Vorlagen muessen in die Ausgabe. Ohne diesen Eintrag liegen sie
        nur im Projektordner: "dotnet run" arbeitet dort und findet sie, die
        veroeffentlichte Exe (ContentRoot = Exe-Verzeichnis) dagegen nicht.

        Was hier liegt, landet beim ersten Start im Vorlagenordner des Anwalts
        (VorlagenSeedService). Dieser Ordner ist kein Ablageplatz fuer
        Testdateien: alles hier ist Saatgut, das der Anwalt spaeter in seiner
        Vorlagenauswahl sieht.
      -->
      <Content Include="Templates\**\*.docx" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
