# EditorConfig fuer den .NET-Teil des Projekts.
# Zusammen mit Directory.Build.props (TreatWarningsAsErrors) legt diese Datei
# fest, was der Build durchgehen laesst. Regeln hier abzuschalten ist eine
# bewusste Entscheidung und gehoert begruendet -- nicht stillschweigend.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.md]
# Zwei Leerzeichen am Zeilenende sind in Markdown ein harter Umbruch.
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# --- Sprachkonventionen -----------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:suggestion
# Klammern nur dort verlangen, wo der Rumpf mehrzeilig ist. Der Bestand nutzt
# durchgehend einzeilige Guard Clauses (if (x is null) return;) -- die sind
# lesbar, und sie alle aufzublaehen waere ein grosser Diff ohne Gewinn.
csharp_prefer_braces = when_multiline:warning
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# Unbenutzte usings sind ein Fehler: sie taeuschen Abhaengigkeiten vor, die es
# nicht gibt, und lassen die Slice-Isolationstests Verstoesse melden, die
# keine sind.
dotnet_diagnostic.IDE0005.severity = warning

# --- Bewusst abgeschaltete Analyzer-Regeln ----------------------------------

# CA1848 / CA1873: verlangen vorkompilierte LoggerMessage-Delegaten statt
# logger.LogInformation(...). Das ist eine Optimierung fuer Dienste mit hohem
# Log-Durchsatz. Diese App bedient genau einen Anwender an einem Rechner; der
# Gewinn ist nicht messbar, der Preis waere ein Delegat je Logzeile und damit
# deutlich schwerer lesbarer Code. Bewusst aus.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# CA1716: warnt vor Bezeichnern, die in anderen .NET-Sprachen (VB, F#)
# Schluesselwoerter sind. Relevant fuer wiederverwendbare Bibliotheken --
# dieses Projekt ist eine geschlossene Anwendung ohne oeffentliche API, und die
# Fachbegriffe sind deutsch. Bewusst aus.
dotnet_diagnostic.CA1716.severity = none

# --- Bewusst verschaerfte Regeln --------------------------------------------

# Kultur-abhaengige String-Operationen sind in dieser App ein echtes Risiko:
# Kennzeichen und Referenzen werden gross-/kleingeschrieben verglichen, und
# ToUpper() ohne Kultur liefert unter tuerkischem Systemgebietsschema ein
# anderes Ergebnis (I -> dotless i). Deshalb Fehler, nicht Hinweis.
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1311.severity = warning
dotnet_diagnostic.CA1862.severity = warning

# Nicht freigegebene IDisposable-Felder sind hier besonders teuer: eine nicht
# entsorgte Word-COM-Instanz bleibt als unsichtbarer WINWORD-Prozess zurueck,
# ein nicht geschlossener Playwright-Context haelt einen Browser offen.
dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA2213.severity = warning

[*.cs]
# Generierter EF-Core-Migrationscode wird nicht von Hand gepflegt.
generated_code = false

[**/Migrations/*.cs]
generated_code = true
